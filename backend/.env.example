# Database
DATABASE_URL="postgresql://user:password@localhost:3005/ai_video_creator"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# API Keys
KLING_API_KEY="your-kling-api-key"
KLING_API_BASE_URL="https://api.klingai.com/v1"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=104857600

# Job Queue
REDIS_URL="redis://localhost:6379"
ENABLE_REDIS=false

# Cost Configuration
INITIAL_USER_CREDITS=50
VIDEO_GENERATION_COST_5S=10
VIDEO_GENERATION_COST_10S=15
VIDEO_GENERATION_COST_15S=20
AUDIO_GENERATION_COST=5
